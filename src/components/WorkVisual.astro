---
// Small product vignettes built from real Pance components.
// Decorative in the card context (the card text carries the meaning).
import { Badge, Avatar, Meter, Button, Sparkline } from '@pance/react';
interface Props {
  kind: 'crm' | 'signal';
}
const { kind } = Astro.props;
const students = [
  { name: 'Valentina Ruiz', course: 'Short story · Oct', state: 'Paid', sev: 'success' },
  { name: 'Mateo Cárdenas', course: 'Novel lab · Nov', state: 'Pending', sev: 'warning' },
  { name: 'Lucía Gómez', course: 'Poetry · Oct', state: 'Paid', sev: 'success' },
  { name: 'Andrés Mora', course: 'Master class', state: 'Waitlist', sev: 'info' },
] as const;
const alerts = [
  { bed: 'Bed 12', text: 'MAP trending down · 3 readings', sev: 'danger', tag: 'Act now' },
  { bed: 'Bed 07', text: 'SpO₂ 91% · steady', sev: 'warning', tag: 'Watch' },
  { bed: 'Bed 03', text: 'Lab result back · K⁺ normal', sev: 'secondary', tag: 'FYI' },
] as const;
---

<div class={`vis vis-${kind}`} aria-hidden="true" inert>
  {kind === 'crm' && (
    <div class="sheet" data-spec="Avatar · Badge · Button — @pance/react">
      <div class="sheet-head">
        <p class="t">
          Students <span>· 4 of 128</span>
        </p>
        <Button size="sm" severity="primary">
          Send WhatsApp
        </Button>
      </div>
      <ul class="rows">
        {students.map((s) => (
          <li>
            <Avatar name={s.name} size={28} decorative />
            <div class="who">
              <b>{s.name}</b>
              <span>{s.course}</span>
            </div>
            <Badge severity={s.sev} size="sm" dot>
              {s.state}
            </Badge>
          </li>
        ))}
      </ul>
      <div class="bubble">“Hola Mateo, tu cupo para el laboratorio de novela sigue reservado hasta el viernes.”</div>
    </div>
  )}
  {kind === 'signal' && (
    <div class="sheet" data-spec="Badge · Meter · Sparkline — @pance/react">
      <div class="sheet-head">
        <p class="t">
          Ward 4B <span>· 3 of 148 alerts need you</span>
        </p>
        <Sparkline
          data={[148, 140, 151, 132, 120, 96, 61]}
          tone="positive"
          size="sm"
          label="Alerts per shift, falling"
        />
      </div>
      <ul class="rows">
        {alerts.map((a) => (
          <li>
            <span class={`dot dot-${a.sev}`}></span>
            <div class="who">
              <b>{a.bed}</b>
              <span>{a.text}</span>
            </div>
            <Badge severity={a.sev} size="sm" variant={a.sev === 'danger' ? 'solid' : 'soft'}>
              {a.tag}
            </Badge>
          </li>
        ))}
      </ul>
      <Meter label="Alert noise filtered" value={98} unit="%" />
    </div>
  )}
</div>

<style>
  .vis {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(56px, 6vw, 72px) clamp(20px, 4vw, 48px) clamp(24px, 4vw, 40px);
    overflow: hidden;
  }
  .vis-crm {
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in srgb, var(--pance-color-emerald-500) 26%, transparent),
        transparent 60%
      ),
      var(--bg-deep);
  }
  .vis-signal {
    background:
      radial-gradient(
        120% 90% at 0% 100%,
        color-mix(in srgb, var(--pance-color-violet-500) 28%, transparent),
        transparent 60%
      ),
      var(--bg-deep);
  }
  .sheet {
    width: min(420px, 100%);
    border-radius: 16px;
    background: var(--pance-color-bg-surface);
    color: var(--pance-color-fg-default);
    border: 1px solid var(--pance-color-border-soft);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6);
    padding: 16px;
    display: grid;
    gap: 12px;
    transform: rotate(-2deg);
    transition: transform 0.8s var(--ease-out);
  }
  :global(.card:hover) .sheet {
    transform: rotate(0deg) scale(1.02);
  }
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .t {
    margin: 0;
    font: 700 14px/1.2 var(--pance-font-family-jakarta);
  }
  .t span {
    font-weight: 500;
    color: var(--pance-color-fg-muted);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .rows li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px solid var(--pance-color-border-soft);
  }
  .who {
    display: grid;
    min-width: 0;
    flex: 1;
  }
  .who b {
    font: 600 13px/1.3 var(--font-sans);
  }
  .who span {
    font: 400 12px/1.3 var(--font-sans);
    color: var(--pance-color-fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bubble {
    justify-self: end;
    max-width: 82%;
    padding: 10px 12px;
    border-radius: 14px 14px 4px 14px;
    background: var(--pance-color-intent-success-soft);
    color: var(--pance-color-intent-success-fg);
    font: 400 12.5px/1.4 var(--font-sans);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .dot-danger {
    background: var(--pance-color-intent-danger-solid);
  }
  .dot-warning {
    background: var(--pance-color-intent-warning-dot, var(--pance-color-amber-500));
  }
  .dot-secondary {
    background: var(--pance-color-border-strong);
  }
</style>
