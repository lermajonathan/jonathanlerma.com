---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import WorkVisual from './WorkVisual.astro';
import { cardCallToAction, type Work } from '../data/work';

interface Props {
  item: Work;
  image?: ImageMetadata;
  wide?: boolean;
  delay?: number;
}
const { item, image, wide = false, delay = 0 } = Astro.props;
---

<a class:list={['card', { 'card-wide': wide }]} href={`/work/${item.slug}/`} data-reveal style={`--d:${delay}`}>
  <div class="card-media">
    {image ? (
      <Image
        src={image}
        alt=""
        widths={[640, 960, 1400]}
        width={1400}
        sizes="(max-width: 900px) 100vw, 66vw"
        loading="lazy"
      />
    ) : (
      item.visual && <WorkVisual kind={item.visual} />
    )}
    <span class="status" data-status={item.status}>
      {item.status}
    </span>
  </div>
  <div class="card-body">
    <p class="mono">{[item.kicker, item.duration].filter(Boolean).join(' · ')}</p>
    <h3 class="h3">{item.title}</h3>
    <p class="body">{item.summary}</p>
    {item.results && (
      <ul class="kpis" aria-label="Results">
        {item.results.map((result) => (
          <li>
            <b>{result.value}</b> {result.label}
          </li>
        ))}
      </ul>
    )}
    <span class="link-arrow">
      {cardCallToAction[item.status]} <Icon name="arrow" />
    </span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 24px;
    background: var(--glass-fill);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-edge), var(--elev-2);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.8s var(--ease-out),
      box-shadow 0.8s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow:
      var(--glass-edge),
      var(--elev-3),
      0 50px 100px -50px color-mix(in srgb, var(--pance-color-aqua-500) 55%, transparent);
  }
  .card:hover .link-arrow {
    background-size: 100% 1px;
  }
  .card-wide {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto;
  }
  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .card-wide .card-media {
    aspect-ratio: auto;
    min-height: 460px;
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
  .card:hover .card-media :global(img) {
    transform: scale(1.04);
  }
  .card-media .status {
    position: absolute;
    top: 18px;
    left: 18px;
  }
  .card-body {
    padding: clamp(24px, 3vw, 40px);
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .card-body p {
    margin: 0;
  }
  .kpis {
    list-style: none;
    margin: 8px 0 6px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .kpis li {
    font-size: 0.85rem;
    color: var(--ink-muted);
    display: grid;
    gap: 4px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .kpis b {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .card-wide {
      grid-template-columns: 1fr;
    }
    .card-wide .card-media {
      min-height: 0;
      aspect-ratio: 16 / 11;
    }
  }
  @media (max-width: 600px) {
    .kpis b {
      font-size: 1.6rem;
    }
  }
</style>
