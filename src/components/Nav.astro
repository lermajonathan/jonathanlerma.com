---
import Icon from './ui/Icon.astro';

const path = Astro.url.pathname;
// On the home page, section links stay on the page; elsewhere they go back home first.
const home = path === '/' ? '' : '/';
const links = [
  { href: `${home}#work`, label: 'Work' },
  { href: '/work/pance/', label: 'Pance' },
  { href: `${home}#services`, label: 'Services' },
  { href: `${home}#trajectory`, label: 'Trajectory' },
  { href: `${home}#about`, label: 'About' },
];
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="nav">
  <div class="container nav-wrap">
    <div class="nav-inner" data-spec="glass · blur 12+12 · saturate 190% · rim light · specular sheen">
      <span class="sheen" aria-hidden="true"></span>
      <a href="/" class="wordmark">
        <span class="mark" aria-hidden="true">
          JL
        </span>
        <span class="name">Jonathan Lerma</span>
      </a>
      <nav aria-label="Main">
        <ul class="links" id="nav-links">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="actions">
        <button
          class="icon-btn inspect"
          type="button"
          data-inspect-toggle
          aria-pressed="false"
          title="Inspect mode (I)"
        >
          <Icon name="inspect" size={18} />
          <span class="inspect-label">Inspect</span>
          <kbd>I</kbd>
        </button>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch theme">
          <Icon name="sun" size={18} class="i-sun" />
          <Icon name="moon" size={18} class="i-moon" />
        </button>
        <a class="btn btn-primary talk" href={`${home}#contact`}>
          Let’s talk
        </a>
        <button class="icon-btn menu" type="button" aria-expanded="false" aria-controls="nav-links" data-menu>
          <span class="sr-only">Menu</span>
          <Icon name="menu" size={20} />
        </button>
      </div>
    </div>
  </div>
  <p id="inspect-live" class="sr-only" aria-live="polite"></p>
</header>

<script>
  // Mobile menu
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu]');
  const menu = document.getElementById('nav-links');
  const setMenuOpen = (open: boolean) => {
    menuButton?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  };
  menuButton?.addEventListener('click', () => setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  // A denser glass once the page scrolls under the bar
  const header = document.querySelector('.nav');
  const syncScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });

  // Specular highlight follows the pointer, like light moving across glass
  const bar = document.querySelector<HTMLElement>('.nav-inner');
  if (bar && window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    bar.addEventListener('pointermove', (event) => {
      const rect = bar.getBoundingClientRect();
      bar.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      bar.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    });
    bar.addEventListener('pointerleave', () => {
      bar.style.removeProperty('--mx');
      bar.style.removeProperty('--my');
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-top: 12px;
    pointer-events: none;
  }
  .nav-wrap {
    padding-inline: max(12px, calc(var(--gutter) - 14px));
  }

  /* Glass capsule — layered like Apple's materials:
     1 backdrop blur + saturation, 2 tinted translucent fill,
     3 rim light (gradient hairline), 4 specular sheen, 5 drop shadow. */
  .nav-inner {
    --mx: 22%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
    padding: 0 10px 0 12px;
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.18) 0%, rgb(255 255 255 / 0.073) 50%, rgb(255 255 255 / 0.035) 100%),
      color-mix(in srgb, var(--pance-color-river-950) 38%, transparent);
    -webkit-backdrop-filter: blur(12px) blur(12px) saturate(190%) brightness(1.06);
    backdrop-filter: blur(12px) blur(12px) saturate(190%) brightness(1.06);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -1px 0 rgb(255 255 255 / 0.04),
      inset 0 0 18px rgb(255 255 255 / 0.03),
      0 1px 2px rgb(0 0 0 / 0.25),
      0 12px 32px -12px rgb(0 0 0 / 0.55),
      0 30px 60px -30px rgb(0 0 0 / 0.5);
    transition:
      background-color 0.4s,
      box-shadow 0.4s;
  }
  /* rim light */
  .nav-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.5),
      rgb(255 255 255 / 0.08) 30%,
      rgb(255 255 255 / 0.03) 60%,
      rgb(255 255 255 / 0.28)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
    z-index: 1;
  }
  /* specular sheen that follows the pointer */
  .sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }
  .sheen::before {
    content: '';
    position: absolute;
    inset: -60% -10%;
    background: radial-gradient(40% 70% at var(--mx) var(--my), rgb(255 255 255 / 0.16), transparent 70%);
    transition: background-position 0.2s;
  }
  .nav:global(.is-scrolled) .nav-inner {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.17) 0%, rgb(255 255 255 / 0.065) 50%, rgb(255 255 255 / 0.03) 100%),
      color-mix(in srgb, var(--pance-color-river-950) 52%, transparent);
  }

  :global(:root[data-theme='light']) .nav-inner {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.8) 0%, rgb(255 255 255 / 0.65) 50%, rgb(255 255 255 / 0.52) 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 1),
      inset 0 -1px 0 rgb(15 23 42 / 0.03),
      0 0 0 1px rgb(15 23 42 / 0.06),
      0 1px 2px rgb(15 23 42 / 0.06),
      0 12px 32px -12px rgb(15 23 42 / 0.18),
      0 30px 60px -30px rgb(15 23 42 / 0.18);
  }
  :global(:root[data-theme='light']) .nav:global(.is-scrolled) .nav-inner {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.83) 0%, rgb(255 255 255 / 0.71) 50%, rgb(255 255 255 / 0.6) 100%);
  }
  :global(:root[data-theme='light']) .nav-inner::before {
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 1),
      rgb(255 255 255 / 0.3) 35%,
      rgb(15 23 42 / 0.04) 70%,
      rgb(255 255 255 / 0.8)
    );
  }
  :global(:root[data-theme='light']) .sheen::before {
    background: radial-gradient(40% 70% at var(--mx) var(--my), rgb(255 255 255 / 0.7), transparent 70%);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
    border-radius: 12px;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--pance-gradient-brand);
    color: #fff;
    font: 600 0.8rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 4px 12px -4px color-mix(in srgb, var(--pance-color-aqua-500) 70%, transparent);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.02rem;
    letter-spacing: -0.025em;
  }
  .links {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .links a:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.06);
  }
  .links a[aria-current] {
    color: var(--ink);
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
  }
  :global(:root[data-theme='light']) .links a:hover {
    background: rgb(15 23 42 / 0.04);
  }
  :global(:root[data-theme='light']) .links a[aria-current] {
    background: rgb(255 255 255 / 0.9);
    box-shadow:
      0 0 0 1px rgb(15 23 42 / 0.06),
      0 2px 6px -2px rgb(15 23 42 / 0.12);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border-radius: 12px;
    border: 0;
    background: rgb(255 255 255 / 0.06);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.06);
    color: var(--ink-soft);
    font: 500 0.8rem/1 var(--font-sans);
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .icon-btn:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.11);
  }
  :global(:root[data-theme='light']) .icon-btn {
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(15 23 42 / 0.07);
  }
  :global(:root[data-theme='light']) .icon-btn:hover {
    background: #fff;
  }
  .inspect[aria-pressed='true'] {
    background: var(--pance-color-aqua-400) !important;
    color: var(--pance-color-slate-950);
  }
  kbd {
    font: 500 0.68rem/1 var(--font-mono);
    padding: 3px 5px;
    border-radius: 4px;
    border: 1px solid currentColor;
    opacity: 0.7;
  }
  [data-theme-toggle] :global(.i-moon) {
    display: none;
  }
  :global(:root[data-theme='light']) [data-theme-toggle] :global(.i-sun) {
    display: none;
  }
  :global(:root[data-theme='light']) [data-theme-toggle] :global(.i-moon) {
    display: block;
  }
  .talk {
    min-height: 40px;
    padding: 0 18px;
    font-size: 0.85rem;
    border-radius: 12px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 6px 16px -6px color-mix(in srgb, var(--pance-color-aqua-600) 80%, transparent);
  }
  .menu {
    display: none;
  }

  @media (max-width: 1040px) {
    .inspect-label,
    .inspect kbd {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .menu {
      display: inline-flex;
    }
    .talk {
      display: none;
    }
    .nav-inner {
      height: 58px;
      border-radius: 18px;
    }
    .links {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 10px;
      border-radius: 20px;
      background:
        linear-gradient(180deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03)),
        color-mix(in srgb, var(--pance-color-river-950) 62%, transparent);
      -webkit-backdrop-filter: blur(12px) blur(12px) saturate(190%);
      backdrop-filter: blur(12px) blur(12px) saturate(190%);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.2),
        inset 0 0 0 1px rgb(255 255 255 / 0.06),
        0 24px 48px -16px rgb(0 0 0 / 0.6);
    }
    :global(:root[data-theme='light']) .links {
      background: rgb(255 255 255 / 0.82);
      box-shadow:
        inset 0 1px 0 #fff,
        0 0 0 1px rgb(15 23 42 / 0.06),
        0 24px 48px -16px rgb(15 23 42 / 0.25);
    }
    .links:global(.is-open) {
      display: flex;
    }
    .links a {
      font-size: 1.25rem;
      font-family: var(--font-display);
      font-weight: 650;
      letter-spacing: -0.03em;
      padding: 12px 14px;
      color: var(--ink);
    }
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
