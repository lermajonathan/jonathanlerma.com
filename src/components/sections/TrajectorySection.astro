---
import SectionHead from '../ui/SectionHead.astro';
import Trajectory from '../Trajectory';
---

<section id="trajectory" class="section ambient" aria-labelledby="traj-title">
  <div class="container">
    <SectionHead
      id="traj-title"
      number="04"
      eyebrow="Trajectory"
      title="From graphic design"
      accent="to design systems."
    >
      Two decades of visual craft, front-end code and product design — and the milestones that made Pance real.
    </SectionHead>
    <Trajectory client:visible />
  </div>
</section>

<style>
  /* Soft coloured light behind the timeline, so its glass cards have something to blur. */
  .ambient {
    overflow: clip;
  }
  .ambient::before {
    content: '';
    position: absolute;
    inset: 10% 0 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(
        40% 30% at 15% 30%,
        color-mix(in srgb, var(--pance-color-violet-500) calc(var(--glow-strength) * 0.55), transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 30% at 85% 55%,
        color-mix(in srgb, var(--pance-color-emerald-500) calc(var(--glow-strength) * 0.45), transparent),
        transparent 70%
      ),
      radial-gradient(
        35% 25% at 30% 85%,
        color-mix(in srgb, var(--pance-color-aqua-500) calc(var(--glow-strength) * 0.5), transparent),
        transparent 70%
      );
    filter: blur(20px);
  }
  .ambient > .container {
    position: relative;
    z-index: 1;
  }
</style>
